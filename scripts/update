#!/bin/sh
set -e
if   command -v yay     >/dev/null 2>&1; then yay -Syu
elif command -v paru    >/dev/null 2>&1; then paru -Syu
elif command -v pacman  >/dev/null 2>&1; then sudo pacman -Syu
elif command -v apt-get >/dev/null 2>&1; then sudo apt-get update && sudo apt-get full-upgrade -y
elif command -v dnf     >/dev/null 2>&1; then sudo dnf upgrade -y
elif command -v apk     >/dev/null 2>&1; then sudo apk upgrade; fi
rustup update
cargo install-update -a

cargo_bin="${CARGO_HOME:-$HOME/.local/share/cargo}/bin"
scripts_dir=$(dirname "$(readlink -f "$0")")
while IFS= read -r bin; do
  [ -x "$cargo_bin/$bin" ] || continue
  sudo install -o root -g root -m 0755 "$cargo_bin/$bin" /usr/local/bin/
done < "$scripts_dir/cargo-system-bins"
