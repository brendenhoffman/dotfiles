#!/bin/sh
MANBIN=/usr/bin/man
BASE=https://man.archlinux.org

case "$1" in ''|-*) exec "$MANBIN" "$@";; esac

section=
case "$1" in [1-9]|[1-9][A-Za-z]) section="$1"; shift;; esac
page="$1"; shift 2>/dev/null||true

[ -n "$section" ]&&"$MANBIN" -w "$section" "$page" >/dev/null 2>&1&&exec "$MANBIN" "$section" "$page" "$@"
[ -z "$section" ]&&"$MANBIN" -w "$page" >/dev/null 2>&1&&exec "$MANBIN" "$page" "$@"

tmp=$(mktemp "${TMPDIR:-/tmp}/man.XXXXXX")||exit 2
trap 'rm -f "$tmp"' EXIT INT TERM

fetch(){ curl -fsSL --max-time 3 "$1" -o "$tmp"&&[ -s "$tmp" ]&&exec "$MANBIN" -l "$tmp"; }

printf 'man: not found locally; trying man.archlinux.org\n' >&2
if [ -n "$section" ]; then
    fetch "$BASE/man/$page.$section.en.raw"
else
    for s in 1 8 5 7 3 2 4; do fetch "$BASE/man/$page.$s.en.raw"||true; done
fi
printf 'man: remote page not found: %s\n' "$page${section:+($section)}" >&2
exit 16
